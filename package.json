{
  "name": "uniben-computing-timetable",
  "version": "0.1.0",
  "private": true,
  "description": "Faculty of Computing, University of Benin — lecture timetable manager",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@electric-sql/pglite": "0.3.16",
    "drizzle-orm": "0.44.7",
    "next": "15.5.26",
    "postgres": "3.4.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
